    <path
        android:pathData="M28.02,69 A30,30 0 0,1 79.98,39"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="69"
                android:endX="80"
                android:endY="39"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#00F2FE" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speedometer Active Gauge Tip Dot -->
    <path
        android:pathData="M79.98,39 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#00F2FE" />

    <!-- Data Burner Primary Cyber Flame Emblem -->
    <path
        android:pathData="M54,23 C46,32 36,42 36,54 C36,66 43.5,75 54,75 C64.5,75 72,66 72,54 C72,42 62,32 54,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="23"
                android:endX="72"
                android:endY="75"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#00F2FE" android:offset="0.45" />
                <item android:color="#3B82F6" android:offset="0.8" />
                <item android:color="#6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Flame Core Ribbon -->
    <path
        android:pathData="M54,31 C49,38 42,45 42,53 C42,61 47.4,67 54,67 C60.6,67 66,61 66,53 C66,45 59,38 54,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="31"
                android:endX="54"
                android:endY="67"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#7FCFFF" android:offset="0.5" />
                <item android:color="#2563EB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
