<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- Top App Bar / Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_dark"
            app:contentInsetStart="16dp"
            app:menu="@menu/menu_main">

            <LinearLayout
                android:id="@+id/logoHeaderContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/appLogoIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/primary_m3"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/controlBarrier"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Section 1: Live Benchmark Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="LIVE BENCHMARK &amp; SPEEDOMETER"
                android:textColor="@color/primary_m3"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Hero Speed Gauge Card (Supports 3D Card Flip via Modular Includes) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                style="@style/Widget.DataBurner.HeroCard"
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:layout_marginTop="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_card">

                    <!-- Front Side (Speedometer Gauge) -->
                    <include
                        android:id="@+id/heroCardFront"
                        layout="@layout/card_hero_front" />

                    <!-- Back Side (Flipped 3D Diagnostics HUD) -->
                    <include
                        android:id="@+id/heroCardBack"
                        layout="@layout/card_hero_back" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Session Metrics Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="REAL-TIME SESSION METRICS"
                android:textColor="@color/primary_m3"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- 2x2 Stats Grid Container with Floating Center Reset Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/statGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <!-- Row 1: Left Card (Burned) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBurnedWrapper"
                    style="@style/Widget.DataBurner.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardTimeWrapper"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <include
                        android:id="@+id/cardBurned"
                        layout="@layout/item_stat_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 1: Right Card (Time) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTimeWrapper"
                    style="@style/Widget.DataBurner.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardBurnedWrapper"
                    app:layout_constraintTop_toTopOf="parent">

                    <include
                        android:id="@+id/cardTime"
                        layout="@layout/item_stat_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 2: Left Card (Peak) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPeakWrapper"
                    style="@style/Widget.DataBurner.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardAvgWrapper"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardBurnedWrapper">

                    <include
                        android:id="@+id/cardPeak"
                        layout="@layout/item_stat_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 2: Right Card (Avg) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvgWrapper"
                    style="@style/Widget.DataBurner.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardPeakWrapper"
                    app:layout_constraintTop_toBottomOf="@+id/cardTimeWrapper">

                    <include
                        android:id="@+id/cardAvg"
                        layout="@layout/item_stat_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Centered Inset Reset Action Badge -->
                <ImageButton
                    android:id="@+id/gridResetBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="Reset All Statistics"
                    android:elevation="0dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/primary_m3"
                    app:layout_constraintBottom_toTopOf="@+id/cardPeakWrapper"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardBurnedWrapper" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Section 3: 5G Network Guard Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="5G NETWORK GUARD PROTECTION"
                android:textColor="@color/primary_m3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 5G Network Guard Feature Card -->
            <include
                android:id="@+id/cardGuard"
                layout="@layout/item_feature_row" />

        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/controlBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="startBtn,stopBtn" />

    <!-- Dynamic Bottom Hero Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/primary_m3"
        android:elevation="4dp"
        android:letterSpacing="0.1"
        android:text="START BURNING"
        android:textColor="@color/bg_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:cornerRadius="20dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconSize="20dp"
        app:iconTint="@color/bg_dark"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopBtn"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="STOP BURNING"
        android:textColor="@color/error_m3"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="20dp"
        app:icon="@android:drawable/ic_media_pause"
        app:iconSize="20dp"
        app:iconTint="@color/error_m3"
        app:strokeColor="@color/error_m3"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
