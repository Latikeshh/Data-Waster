<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_stat_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- Status Indicator Dot -->
    <View
        android:id="@+id/threadStatusDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_status_dot_active" />

    <!-- Center Thread Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/threadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thread #01"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/threadSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Streaming Stream #1 • Active"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Right Speed / Status Badge -->
    <TextView
        android:id="@+id/threadSpeedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_m3_chip_emerald"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="ACTIVE"
        android:textColor="#34D399"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
