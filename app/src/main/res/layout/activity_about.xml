<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".AboutActivity">

    <!-- Top Navigation Toolbar Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/aboutAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/aboutToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_dark"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary_m3"
            app:title="About Data Burner"
            app:titleTextColor="@color/primary_m3" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/aboutScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aboutAppBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="48dp">

            <!-- App Brand Header -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/aboutTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.2"
                android:text="DATA BURNER v1.0"
                android:textColor="@color/primary_m3"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:alpha="0.6"
                android:text="5G High-Speed Benchmark &amp; Guard Utility"
                android:textColor="@color/on_surface"
                android:textSize="12sp" />

            <!-- SECTION A: ABOUT US LAYOUT -->
            <LinearLayout
                android:id="@+id/aboutSectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ FEATURES &amp; HIGHLIGHTS"
                    android:textColor="@color/tertiary_m3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_m3_surface_container"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Multi-Threaded Engine: 20 Parallel Worker Streams"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• 5G Network Guard: Siren Alert &amp; Vibration on Drop"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• High-Speed Multi-Threaded CDN Engine"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Target Quota Limit: Auto-stop Cap Protection"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="🛡️ PRIVACY &amp; SECURITY"
                    android:textColor="@color/tertiary_m3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_m3_surface_container"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Zero Data Storage: Streams RAM-only byte buffers"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• 100% Independent &amp; Open Source Architecture"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION B: MORE TECH SPECS LAYOUT -->
            <LinearLayout
                android:id="@+id/techSpecsSectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ TECHNICAL SPECIFICATIONS"
                    android:textColor="@color/tertiary_m3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_m3_surface_container"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Buffer Size: 64 KB per chunk read"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Timeouts: 5000ms Connect / 8000ms Read"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Protocol: HTTP/1.1 over TLS 1.3 (HTTPS)"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="🌐 TEST CDN MIRROR ENDPOINTS"
                    android:textColor="@color/tertiary_m3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_m3_surface_container"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• ash-speed.hetzner.com (1 GB Bin)"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• speed.hetzner.de (1 GB Bin)"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• speedtest.belwue.net (10G Test File)"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• speedtest.tele2.net (100 MB Zip)"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• ftp.otenet.gr (100 MB Test DB)"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
